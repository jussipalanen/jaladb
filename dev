#!/usr/bin/env bash
#
# Development helper for JalaDB: short commands for Docker and database tasks.
#
#   ./dev help
#
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

ADMINER_PORT_DEFAULT=8080

compose() {
  docker compose "$@"
}

# Includes the "app" profile (migrate, api, console), so commands like down,
# ps and logs also cover the containers started by ./dev up-all.
compose_all() {
  docker compose --profile app "$@"
}

# Runs a command in a container. Without a terminal on stdin no TTY is
# allocated, so SQL can be piped in:  ./dev psql < query.sql
compose_exec() {
  if [ -t 0 ]; then compose exec "$@"; else compose exec -T "$@"; fi
}

env_value() {
  local key=$1 default=$2 value=""
  if [ -f .env ]; then
    value=$(grep -E "^${key}=" .env | tail -n 1 | cut -d= -f2- || true)
  fi
  echo "${value:-$default}"
}

ensure_env() {
  if [ ! -f .env ]; then
    cp .env.example .env
    echo "Created .env from .env.example"
  fi
}

ensure_node_modules() {
  if [ ! -d node_modules ]; then
    npm install
  fi
}

ensure_frontend_modules() {
  if [ ! -d frontend/node_modules ]; then
    npm --prefix frontend install
  fi
}

ensure_backend_modules() {
  ensure_node_modules  # the API tests use the database tooling in the root
  if [ ! -d backend/node_modules ]; then
    npm --prefix backend install
  fi
}

confirm() {
  local prompt=$1
  if [ "${ASSUME_YES:-0}" = 1 ]; then return 0; fi
  read -r -p "$prompt [y/N] " answer
  [[ $answer =~ ^[Yy]$ ]]
}

adminer_url() {
  local user db
  user=$(env_value POSTGRES_USER jaladb)
  db=$(env_value POSTGRES_DB jaladb)
  echo "http://localhost:$(env_value ADMINER_PORT "$ADMINER_PORT_DEFAULT")/?pgsql=postgres&username=${user}&db=${db}"
}

cmd_help() {
  cat <<EOF
Usage: ./dev <command> [args]

Docker
  up                 Start PostgreSQL and Adminer (for ./dev api and ./dev ui)
  up-all             Build and start everything in Docker: PostgreSQL, Adminer,
                     migrations, API (:$(env_value API_PORT 3000)) and console (:$(env_value CONSOLE_PORT 8081))
  down               Stop all containers (data is kept)
  restart            Restart the running containers
  ps                 Show container status
  logs [service]     Follow logs (all, or postgres / adminer / migrate / api / console)

Database
  psql [args]        Open psql in the database container (extra args go to psql)
  shell              Open a shell in the database container
  migrate            Apply pending migrations
  status             List applied and pending migrations
  seed               Replace all data with the sample dataset
  seed-large         Replace all data with the sample + large generated dataset
  reset [-y]         Delete ALL data, then start, migrate and seed from scratch

API (backend/)
  api                Start the API locally in watch mode on http://localhost:$(env_value API_PORT 3000)
                     (uses the same port as the api container; run ./dev down first after up-all)
  test-api           Run the API integration tests

Console (frontend/)
  ui                 Start the demo console on http://localhost:5173 (needs ./dev api)
  test-ui            Run the console's component tests

Project
  setup              First-time setup: .env, npm install, start, migrate, seed
  test               Run the database integration tests
  adminer            Print the Adminer login URL
  help               Show this help

Examples
  ./dev up-all && ./dev seed    # everything in Docker, with sample data
  ./dev setup
  ./dev psql -c 'SELECT * FROM products LIMIT 5'
  ./dev psql < some_query.sql
EOF
}

cmd_up() {
  ensure_env
  compose up -d --wait
  echo "PostgreSQL: localhost:$(env_value POSTGRES_PORT 5432)"
  echo "Adminer:    $(adminer_url)"
}

cmd_up_all() {
  ensure_env
  compose_all up -d --build --wait
  echo "Console:    http://localhost:$(env_value CONSOLE_PORT 8081)"
  echo "API:        http://localhost:$(env_value API_PORT 3000)/api/health"
  echo "Adminer:    $(adminer_url)"
  echo "PostgreSQL: localhost:$(env_value POSTGRES_PORT 5432)"
  echo
  echo "Migrations are applied. Load sample data with './dev seed'."
}

cmd_down()    { compose_all down; }
cmd_restart() { compose_all restart; }
cmd_ps()      { compose_all ps "$@"; }
cmd_logs()    { compose_all logs -f --tail 100 "$@"; }

cmd_psql() {
  # Uses the credentials already configured inside the container.
  # shellcheck disable=SC2016
  compose_exec postgres \
    sh -c 'exec psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" "$@"' psql "$@"
}

cmd_shell() { compose_exec postgres bash; }

cmd_migrate() { ensure_node_modules; npm run -s db:migrate; }
cmd_status()  { ensure_node_modules; npm run -s db:status; }
cmd_seed()    { ensure_node_modules; npm run -s db:seed; }
cmd_seed_large() { ensure_node_modules; npm run -s db:seed:large; }
cmd_test()    { ensure_node_modules; npm test; }
cmd_api()     { ensure_env; ensure_backend_modules; npm --prefix backend run dev; }
cmd_test_api() { ensure_backend_modules; npm --prefix backend test; }
cmd_ui()      { ensure_env; ensure_frontend_modules; npm --prefix frontend run dev; }
cmd_test_ui() { ensure_frontend_modules; npm --prefix frontend test; }

cmd_reset() {
  if [ "${1:-}" = "-y" ]; then ASSUME_YES=1; fi
  if ! confirm "This deletes ALL local database data. Continue?"; then
    echo "Aborted."
    exit 1
  fi
  compose_all down -v
  cmd_up
  cmd_migrate
  cmd_seed
}

cmd_setup() {
  ensure_env
  ensure_backend_modules
  ensure_frontend_modules
  cmd_up
  cmd_migrate
  cmd_seed
  echo
  echo "Ready. Run './dev test', './dev test-api' and './dev test-ui' to run the tests."
  echo "Start the API with './dev api' and the console with './dev ui' (second terminal)."
}

cmd_adminer() {
  adminer_url
  echo "Password: $(env_value POSTGRES_PASSWORD jaladb_local)"
}

main() {
  local command=${1:-help}
  shift || true

  case $command in
    up | down | restart | ps | logs | psql | shell | migrate | status | seed | reset | setup | test | adminer)
      "cmd_$command" "$@"
      ;;
    up-all)
      cmd_up_all "$@"
      ;;
    seed-large)
      cmd_seed_large "$@"
      ;;
    api)
      cmd_api "$@"
      ;;
    test-api)
      cmd_test_api "$@"
      ;;
    ui)
      cmd_ui "$@"
      ;;
    test-ui)
      cmd_test_ui "$@"
      ;;
    help | -h | --help)
      cmd_help
      ;;
    *)
      echo "Unknown command: $command" >&2
      echo >&2
      cmd_help >&2
      exit 1
      ;;
  esac
}

main "$@"
