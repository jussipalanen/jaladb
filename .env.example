# Local development configuration. Copy to .env and adjust as needed.
# These values are for a local Docker database only; never commit a real .env.

POSTGRES_USER=jaladb
POSTGRES_PASSWORD=jaladb_local
POSTGRES_DB=jaladb
POSTGRES_PORT=5432

# Adminer web GUI: http://localhost:8080
ADMINER_PORT=8080

# Node.js API (backend/): http://localhost:3000
API_PORT=3000

# Used by the migration/seed scripts, the API and the test suites.
# The tests create and drop a separate "<database>_test" database next to this one.
DATABASE_URL=postgres://jaladb:jaladb_local@localhost:5432/jaladb
